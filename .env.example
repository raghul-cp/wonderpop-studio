# Copy this file to .env for local runs. Never commit the real .env file.
# In GitHub Actions, these same names are set as repo Secrets instead
# (see .github/workflows/daily_content.yml and SETUP.md) — the .env file
# is only used for your own machine.

# ----- Content generation engine -----
# template  = free, offline, zero setup (DEFAULT — leave as-is to start)
# ollama    = free local LLM via Ollama (optional, needs Ollama installed)
# anthropic = paid Claude API (optional, best quality)
CONTENT_ENGINE=template

# Only used if CONTENT_ENGINE=anthropic
ANTHROPIC_API_KEY=

# Only used if CONTENT_ENGINE=ollama
OLLAMA_MODEL=llama3.2:1b
OLLAMA_HOST=http://localhost:11434

# ----- Feature toggles (all free services) -----
ENABLE_IMAGE_GENERATION=true
ENABLE_VOICEOVER_AUDIO=true
ENABLE_VIDEO_ASSEMBLY=true

# ----- YouTube upload (off until you complete SETUP.md's OAuth steps) -----
ENABLE_UPLOAD=false
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
